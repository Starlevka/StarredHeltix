{
	"schemaVersion": 1,
	"id": "starredheltix",
	"version": "1.0.0",
	"name": "StarredHeltix",
	"description": "Один из супер-пуперских модов для Heltix Skyblock",
	"authors": [
		"Starlev"
	],
	"license": "LGPL-3.0",
	"icon": "assets/starredheltix/icon.png",
	"accessWidener": "starredheltix.accesswidener",
	"entrypoints": {
		"client": [
			{
				"value": "set.starlev.StarredHeltix",
				"adapter": "kotlin"
			}
		],
		"modmenu": [
			{
				"value": "set.starlev.utils.ModMenuIntegration",
				"adapter": "kotlin"
			}
		]
	},
	"custom": {
		"fabric-resource-loader:v0": {
			"builtin_resource_packs": [
				{
					"id": "starredheltix_internal",
					"name": "StarredHeltix Internal",
					"enabled_by_default": true
				}
			]
		}
	},
	"mixins": [
		{
			"config": "starredheltix.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}
