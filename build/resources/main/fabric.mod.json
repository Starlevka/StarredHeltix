{
	"schemaVersion": 1,
	"id": "starredheltix",
	"version": "0.0.10",
	"name": "StarredHeltix",
	"description": "Хелтикс мод с функционалом уф >:P",
	"authors": [
		"Starlev"
	],
	"license": "LGPL-3.0",
	"icon": "assets/starredheltix/icon.png",
	"contact": {
		"homepage": "https://github.com/Starlevka/StarredHeltix",
		"sources": "https://github.com/Starlevka/StarredHeltix"
	},
	"environment": "client",
	"entrypoints": {
		"client": [
			{
				"value": "set.starlev.StarredHeltix",
				"adapter": "kotlin"
			}
		],
		"modmenu": [
			{
				"value": "set.starlev.utils.ModMenuIntegration",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		{
			"config": "starredheltix.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "starredheltix.accesswidener",
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}
